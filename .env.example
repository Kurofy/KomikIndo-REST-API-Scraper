# Target Komikindo Base URL (can be changed dynamically at runtime)
BASE_URL=https://komikindo.ch

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Scraper Settings
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
REQUEST_TIMEOUT=15

# Cache TTL Settings (in seconds)
HOMEPAGE_CACHE_TTL=600
LATEST_CACHE_TTL=600
COMIC_DETAIL_CACHE_TTL=1800
SEARCH_CACHE_TTL=1800
GENRES_CACHE_TTL=86400
CHAPTER_CACHE_TTL=86400
